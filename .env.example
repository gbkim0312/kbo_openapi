APP_ENV=development
POSTGRES_PASSWORD=change-me
# OMV Compose 전용: PostgreSQL 데이터를 보관할 OMV 공유 폴더의 절대 경로
# 예: /srv/dev-disk-by-uuid-xxxx/appdata/kbo-openapi/postgres
KBO_POSTGRES_DATA_DIR=
# OMV Compose 전용: 호스트에서 API에 접속할 포트
KBO_API_PORT=8085
DATABASE_URL=postgresql+asyncpg://kbo:${POSTGRES_PASSWORD}@postgres:5432/kbo
ADMIN_API_KEY=change-me
KBO_BASE_URL=https://www.koreabaseball.com
KBO_SCHEDULE_URL=https://www.koreabaseball.com/ws/Schedule.asmx/GetScheduleList
KBO_USER_AGENT=kbo-result-api/0.1
KBO_CONNECT_TIMEOUT_SECONDS=5
KBO_READ_TIMEOUT_SECONDS=15
KBO_TOTAL_TIMEOUT_SECONDS=20
KBO_MAX_RETRIES=3
KBO_HTTP_FALLBACK_ON_SCHEMA_ERROR=true
KBO_CLI_ENABLED=true
KBO_PLAYWRIGHT_ENABLED=false
RAW_SNAPSHOT_ENABLED=true
RAW_SNAPSHOT_MAX_BYTES=5242880
SCHEDULER_ENABLED=true
# 경기 상태별 KBO 원본 수집 주기(초)
KBO_REFRESH_IDLE_SECONDS=300
KBO_REFRESH_PRE_GAME_SECONDS=60
KBO_REFRESH_LIVE_SECONDS=15
KBO_REFRESH_LATE_GAME_SECONDS=10
KBO_REFRESH_FAILURE_BACKOFF_MAX_SECONDS=120
MAX_QUERY_RANGE_DAYS=31
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
